# ── Data (too large for git) ────────────────────────────────
data/TrainData/
data/ValidData/
data/TestData/

# ── Model checkpoints ───────────────────────────────────────
checkpoints/*.pth
checkpoints/*.pt

# ── Predictions (HDF5 output masks) ─────────────────────────
predictions/*.h5

# ── Visualization outputs ────────────────────────────────────
visualizations/*.png
visualizations/*.jpg

# ── Virtual environment ──────────────────────────────────────
venv_landslide/
venv/
.venv/

# ── Python cache ─────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Jupyter ──────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── OS files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Logs and temp ────────────────────────────────────────────
*.log
*.tmp
*.egg-info/
dist/
build/

# ── Keep folder structure in git ─────────────────────────────
!checkpoints/.gitkeep
!predictions/.gitkeep
!visualizations/.gitkeep

